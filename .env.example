DATABASE_URL=postgres://user:pass@host/db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
CHANNEL_ENC_KEY=
ADMIN_PASSWORD=
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=AgentOS <agents@yourdomain.com>
EMAIL_TARGET=you@yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: dedicated ops key for operational endpoints (POST /api/admin/migrate|seed|bootstrap|recover).
# Same trust level as ADMIN_PASSWORD. If unset, ADMIN_PASSWORD is required there instead.
OPS_TOKEN=

# ---- Sign-in with Google (Access & Identity Overhaul) ----
# Create at https://console.cloud.google.com/apis/credentials (OAuth client ID,
# type "Web application"). Authorized redirect URI must be exactly:
#   https://YOUR-DOMAIN/api/auth/oauth/google/callback
# When both are unset, the Google button hides and password sign-in stays.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allowlist of Google emails that may auto-provision as the
# FIRST owner when no user exists yet. Existing users always link by verified
# email regardless of this list. Example: owner@yourdomain.com
OWNER_EMAILS=
# Optional: 32-byte hex key for signing the OAuth state; defaults to a key
# derived from CHANNEL_ENC_KEY (fine unless you rotate that often).
# GOOGLE_OAUTH_STATE_SECRET=

# Optional tuning (defaults shown):
# DAILY_TENANT_LLM_CAP=200
